  "capture": {
    "title": "Reference capture",
    "intro": "Nine sharp photos from these angles give the models a reliable likeness. Or import a slow 10–15 s head turn and the studio picks the sharpest frames.",
    "checklist": [
      {
        "id": "front",
        "title": "Front",
        "instruction": "Look straight into the lens, relaxed and neutral.",
        "sfSymbol": "person.fill"
      },
      {
        "id": "threeQuarterLeft",
        "title": "¾ left",
        "instruction": "Turn your head about 45° to your left, eyes following the nose.",
        "sfSymbol": "arrow.turn.up.left"
      },
      {
        "id": "threeQuarterRight",
        "title": "¾ right",
        "instruction": "Turn your head about 45° to your right.",
        "sfSymbol": "arrow.turn.up.right"
      },
      {
        "id": "profileLeft",
        "title": "Profile left",
        "instruction": "Full side view facing left — one ear, one eye visible.",
        "sfSymbol": "arrow.left"
      },
      {
        "id": "profileRight",
        "title": "Profile right",
        "instruction": "Full side view facing right.",
        "sfSymbol": "arrow.right"
      },
      {
        "id": "smile",
        "title": "Smile",
        "instruction": "Front view with a natural, open smile.",
        "sfSymbol": "face.smiling"
      },
      {
        "id": "expression",
        "title": "Expression",
        "instruction": "Any strong expression: surprise, anger, laughing.",
        "sfSymbol": "theatermasks"
      },
      {
        "id": "lowAngle",
        "title": "Slightly below",
        "instruction": "Camera a little below eye level, looking up at the face.",
        "sfSymbol": "arrow.up.circle"
      },
      {
        "id": "fullBody",
        "title": "Full body",
        "instruction": "Head to toe, standing naturally, in the usual wardrobe.",
        "sfSymbol": "figure.stand"
      }
    ],
    "tips": [
      "Use the back camera, 1.5–2 m away, with the 2× lens — no wide-angle distortion.",
      "No filters, no Portrait mode, no beauty or face smoothing.",
      "Sharp, even light: face a window or shoot outside in shade. Avoid hard shadows and backlight.",
      "Hair away from the face; no sunglasses or hats unless they are part of the look.",
      "Keep the same look in every photo: same hair, beard and makeup."
    ],
    "video": {
      "minSeconds": 10,
      "maxSeconds": 15,
      "instruction": "Film a slow head turn from one profile to the other and back, 10–15 s, in even light."
    },
    "camera": {
      "position": "back",
      "zoom": 2
    }
  }
}
